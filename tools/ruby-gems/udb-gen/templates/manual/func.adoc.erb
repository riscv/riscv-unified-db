:tabs-sync-option:

// definitions and helper functions for ISA definitions

= Functions

<%- cfg_arch.functions.each do |f| -%>
<%= anchor_for(f) %>
== <%= f.name %><%- if f.builtin? -%> (builtin)<%- end -%><%- if f.generated? -%> (generated)<%- end -%>

<%= f.description %>

[cols="1,2"]
|===
h| Return Type
a|
<%= idl_code_html_block(f.return_type_list_str.join(', ')) %>

h| Arguments
a|
<%- if f.arguments_list_str.empty? -%>
None
<%- else -%>
<%= idl_code_html_block(f.arguments_list_str.join(', ')) %>
<%- end -%>
|===

<%- unless f.builtin? || f.generated? -%>
<%- body_ast = f.body -%>
<%= idl_code_html_block(body_ast.to_idl, idl_link_map(body_ast), column_width: 80) %>
<%- end -%>

<%- end -%>
