<%= anchor_for_udb_doc_inst(inst.name) %>
= <%= inst.name %>

Synopsis::
<%= inst.long_name %>

Mnemonic::
----
<%= inst.name %> <%= inst.assembly.gsub('x', 'r') %>
----

Encoding::
<%- if inst.multi_encoding? -%>
[NOTE]
This instruction has different encodings in RV32 and RV64

RV32::
[wavedrom, ,svg,subs='attributes',width="100%"]
....
<%= inst.processed_wavedrom_desc(32) %>
....

RV64::
[wavedrom, ,svg,subs='attributes',width="100%"]
....
<%= inst.processed_wavedrom_desc(64) %>
....
<%- else -%>
[wavedrom, ,svg,subs='attributes',width="100%"]
....
<%= inst.processed_wavedrom_desc(inst.base.nil? ? 64 : inst.base) %>
....
<%- end -%>

Description::
<%= inst.fix_entities(inst.description) %>


Decode Variables::

<%- if inst.multi_encoding? ? (inst.decode_variables(32).empty? && inst.decode_variables(64).empty?) : inst.decode_variables(inst.base.nil? ? 64 : inst.base).empty? -%>

<%= inst.name %> has no decode variables.

<%- else -%>
<%- if inst.multi_encoding? -%>
RV32::
+
<%- _dv32 = inst.decode_variables(32).map { |d| "#{d.sext? ? 'signed ' : ''}Bits<#{d.size}> #{d.name} = #{d.extract};" }.join("\n") -%>
ifdef::backend-pdf[]
[source,idl]
----
<%= _dv32 %>
----
endif::[]
ifndef::backend-pdf[]
<%= idl_code_html_block(_dv32, format: false) %>
endif::[]

RV64::
+
<%- _dv64 = inst.decode_variables(64).map { |d| "#{d.sext? ? 'signed ' : ''}Bits<#{d.size}> #{d.name} = #{d.extract};" }.join("\n") -%>
ifdef::backend-pdf[]
[source,idl]
----
<%= _dv64 %>
----
endif::[]
ifndef::backend-pdf[]
<%= idl_code_html_block(_dv64, format: false) %>
endif::[]
<%- else -%>
<%- _dv = inst.decode_variables(inst.base.nil? ? 64 : inst.base).map { |d| "#{d.sext? ? 'signed ' : ''}Bits<#{d.size}> #{d.name} = #{d.extract};" }.join("\n") -%>
ifdef::backend-pdf[]
[source,idl]
----
<%= _dv %>
----
endif::[]
ifndef::backend-pdf[]
<%= idl_code_html_block(_dv, format: false) %>
endif::[]
<%- end # if multi_encoding? -%>
<%- end # if no decode variables-%>

<% unless inst.data["operation()"].nil? %>
Operation::
<%- _op_ast = inst.operation_ast -%>
<%- _op_idl = idl_format(_op_ast.to_idl(include_comments: true), column_width: 80) -%>
ifdef::backend-pdf[]
[source,idl,idl-links="<%= idl_code_links_attr(_op_ast) %>"]
----
<%= _op_idl %>
----
endif::[]
ifndef::backend-pdf[]
<%= idl_code_html_block(_op_idl, idl_link_map(_op_ast), format: false) %>
endif::[]
<% end %>

Included in::
--
`<%= inst.name %>` is unconditionally defined by the following:

|===
| Extension | Version

<%- ext_reqs.each do |ext_req| -%>
<%-   vers = ext_req.satisfying_versions.select { |v| (-inst.defined_by_condition & v.to_condition_exclusive).unsatisfiable_by_arch?(cfg_arch) } -%>
<%-   unless vers.empty? -%>
<%-     max_ext_req = Udb::ExtensionRequirement.create_from_ext_vers(vers) -%>
| *<%= max_ext_req.name %>*
| <%= inst.fix_entities(max_ext_req.requirement_specs_to_s_pretty) %>
<%-   end -%>

<%- end -%>
|===

--
