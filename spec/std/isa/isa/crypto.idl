function crypto_aes_sbox_fwd {
  returns Bits<8>
  arguments Bits<8> value
  description {
    Apply the forward AES S-box.
  }
  body {
    return crypto_aes_sbox_fwd_table[value];
  }
}

function crypto_aes_sbox_inv {
  returns Bits<8>
  arguments Bits<8> value
  description {
    Apply the inverse AES S-box.
  }
  body {
    return crypto_aes_sbox_inv_table[value];
  }
}

function crypto_aes_mixcolumn_byte_fwd {
  returns Bits<32>
  arguments Bits<8> value
  description {
    Return the forward AES MixColumns contribution for one byte.
  }
  body {
    Bits<8> two = crypto_aes_xtime(value);
    Bits<8> three = two ^ value;
    return {three, value, value, two};
  }
}

function crypto_aes_mixcolumn_byte_inv {
  returns Bits<32>
  arguments Bits<8> value
  description {
    Return the inverse AES MixColumns contribution for one byte.
  }
  body {
    return {
      crypto_aes_gf_mul(value, 0x0b),
      crypto_aes_gf_mul(value, 0x0d),
      crypto_aes_gf_mul(value, 0x09),
      crypto_aes_gf_mul(value, 0x0e)
    };
  }
}

function crypto_aes_mixcolumn_fwd {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Apply the forward AES MixColumns transform to one column.
  }
  body {
    Bits<8> s0 = value[7:0];
    Bits<8> s1 = value[15:8];
    Bits<8> s2 = value[23:16];
    Bits<8> s3 = value[31:24];
    Bits<8> b0 = crypto_aes_xtime(s0) ^ (crypto_aes_xtime(s1) ^ s1) ^ s2 ^ s3;
    Bits<8> b1 = s0 ^ crypto_aes_xtime(s1) ^ (crypto_aes_xtime(s2) ^ s2) ^ s3;
    Bits<8> b2 = s0 ^ s1 ^ crypto_aes_xtime(s2) ^ (crypto_aes_xtime(s3) ^ s3);
    Bits<8> b3 = (crypto_aes_xtime(s0) ^ s0) ^ s1 ^ s2 ^ crypto_aes_xtime(s3);
    return {b3, b2, b1, b0};
  }
}

function crypto_aes_mixcolumn_inv {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Apply the inverse AES MixColumns transform to one column.
  }
  body {
    Bits<8> s0 = value[7:0];
    Bits<8> s1 = value[15:8];
    Bits<8> s2 = value[23:16];
    Bits<8> s3 = value[31:24];
    Bits<8> b0 = crypto_aes_gf_mul(s0, 0x0e) ^ crypto_aes_gf_mul(s1, 0x0b) ^ crypto_aes_gf_mul(s2, 0x0d) ^ crypto_aes_gf_mul(s3, 0x09);
    Bits<8> b1 = crypto_aes_gf_mul(s0, 0x09) ^ crypto_aes_gf_mul(s1, 0x0e) ^ crypto_aes_gf_mul(s2, 0x0b) ^ crypto_aes_gf_mul(s3, 0x0d);
    Bits<8> b2 = crypto_aes_gf_mul(s0, 0x0d) ^ crypto_aes_gf_mul(s1, 0x09) ^ crypto_aes_gf_mul(s2, 0x0e) ^ crypto_aes_gf_mul(s3, 0x0b);
    Bits<8> b3 = crypto_aes_gf_mul(s0, 0x0b) ^ crypto_aes_gf_mul(s1, 0x0d) ^ crypto_aes_gf_mul(s2, 0x09) ^ crypto_aes_gf_mul(s3, 0x0e);
    return {b3, b2, b1, b0};
  }
}

function crypto_aes_subword_fwd {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Apply the forward AES S-box to each byte in a word.
  }
  body {
    return {
      crypto_aes_sbox_fwd(value[31:24]),
      crypto_aes_sbox_fwd(value[23:16]),
      crypto_aes_sbox_fwd(value[15:8]),
      crypto_aes_sbox_fwd(value[7:0])
    };
  }
}

function crypto_aes_subword_inv {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Apply the inverse AES S-box to each byte in a word.
  }
  body {
    return {
      crypto_aes_sbox_inv(value[31:24]),
      crypto_aes_sbox_inv(value[23:16]),
      crypto_aes_sbox_inv(value[15:8]),
      crypto_aes_sbox_inv(value[7:0])
    };
  }
}

function crypto_aes_subbytes_fwd64 {
  returns Bits<64>
  arguments Bits<64> value
  description {
    Apply the forward AES S-box to each byte in a doubleword.
  }
  body {
    return {
      crypto_aes_subword_fwd(value[63:32]),
      crypto_aes_subword_fwd(value[31:0])
    };
  }
}

function crypto_aes_subbytes_inv64 {
  returns Bits<64>
  arguments Bits<64> value
  description {
    Apply the inverse AES S-box to each byte in a doubleword.
  }
  body {
    return {
      crypto_aes_subword_inv(value[63:32]),
      crypto_aes_subword_inv(value[31:0])
    };
  }
}

function crypto_byte_select64 {
  returns Bits<8>
  arguments
    Bits<64> value,
    U32 byte_select
  description {
    Return byte +byte_select+ from a 64-bit little-endian value.
  }
  body {
    return (value >> (byte_select * 8))[7:0];
  }
}

function crypto_aes_rv64_shiftrows_fwd {
  returns Bits<64>
  arguments
    Bits<64> rs2,
    Bits<64> rs1
  description {
    Assemble one forward AES ShiftRows half-state for the RV64 instructions.
  }
  body {
    return {
      crypto_byte_select64(rs1, 3),
      crypto_byte_select64(rs2, 6),
      crypto_byte_select64(rs2, 1),
      crypto_byte_select64(rs1, 4),
      crypto_byte_select64(rs2, 7),
      crypto_byte_select64(rs2, 2),
      crypto_byte_select64(rs1, 5),
      crypto_byte_select64(rs1, 0)
    };
  }
}

function crypto_aes_rv64_shiftrows_inv {
  returns Bits<64>
  arguments
    Bits<64> rs2,
    Bits<64> rs1
  description {
    Assemble one inverse AES ShiftRows half-state for the RV64 instructions.
  }
  body {
    return {
      crypto_byte_select64(rs2, 3),
      crypto_byte_select64(rs2, 6),
      crypto_byte_select64(rs1, 1),
      crypto_byte_select64(rs1, 4),
      crypto_byte_select64(rs1, 7),
      crypto_byte_select64(rs2, 2),
      crypto_byte_select64(rs2, 5),
      crypto_byte_select64(rs1, 0)
    };
  }
}

function crypto_aes_rcon {
  returns Bits<32>
  arguments Bits<4> round
  description {
    Return the AES round constant used by AES64KS1I.
  }
  body {
    if (round == 0) {
      return 0x00000001;
    } else if (round == 1) {
      return 0x00000002;
    } else if (round == 2) {
      return 0x00000004;
    } else if (round == 3) {
      return 0x00000008;
    } else if (round == 4) {
      return 0x00000010;
    } else if (round == 5) {
      return 0x00000020;
    } else if (round == 6) {
      return 0x00000040;
    } else if (round == 7) {
      return 0x00000080;
    } else if (round == 8) {
      return 0x0000001b;
    } else if (round == 9) {
      return 0x00000036;
    }
    return 0;
  }
}

