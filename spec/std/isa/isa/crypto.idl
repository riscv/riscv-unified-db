%version: 1.0

function validate_seed_access {
  arguments Bits<32> encoding
  description {
    Validate a `seed` CSR access and raise the architecturally required
    exception when it is not permitted.
  }
  body {
    Bits<3> funct3 = encoding[14:12];
    Bits<5> source = encoding[19:15];
    Boolean read_only_access =
      (funct3 == 3'b010 || funct3 == 3'b011 ||
       funct3 == 3'b110 || funct3 == 3'b111) && source == 0;

    if (read_only_access) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }

    if (mode() == PrivilegeMode::U && CSR[mseccfg].USEED == 0) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }

    if (mode() == PrivilegeMode::S && CSR[mseccfg].SSEED == 0) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }

    if (mode() == PrivilegeMode::VS || mode() == PrivilegeMode::VU) {
      if (CSR[mseccfg].SSEED == 0) {
        raise(ExceptionCode::IllegalInstruction, mode(), encoding);
      }
      raise(ExceptionCode::VirtualInstruction, mode(), encoding);
    }
  }
}

function crypto_ror32 {
  returns Bits<32>
  arguments
    Bits<32> value,
    U32 amount
  description {
    Rotate a 32-bit value right by +amount+ bits.
  }
  body {
    if (amount == 0) {
      return value;
    }
    return (value >> amount) | (value << (32 - amount));
  }
}

function crypto_rol32 {
  returns Bits<32>
  arguments
    Bits<32> value,
    U32 amount
  description {
    Rotate a 32-bit value left by +amount+ bits.
  }
  body {
    if (amount == 0) {
      return value;
    }
    return (value << amount) | (value >> (32 - amount));
  }
}

function crypto_ror64 {
  returns Bits<64>
  arguments
    Bits<64> value,
    U32 amount
  description {
    Rotate a 64-bit value right by +amount+ bits.
  }
  body {
    if (amount == 0) {
      return value;
    }
    return (value >> amount) | (value << (64 - amount));
  }
}

function crypto_rol8 {
  returns Bits<8>
  arguments
    Bits<8> value,
    U32 amount
  description {
    Rotate an 8-bit value left by +amount+ bits.
  }
  body {
    if (amount == 0) {
      return value;
    }
    return (value << amount) | (value >> (8 - amount));
  }
}

function crypto_byte_select32 {
  returns Bits<8>
  arguments
    Bits<32> value,
    Bits<2> byte_select
  description {
    Return byte +byte_select+ from a 32-bit little-endian value.
  }
  body {
    if (byte_select == 0) {
      return value[7:0];
    } else if (byte_select == 1) {
      return value[15:8];
    } else if (byte_select == 2) {
      return value[23:16];
    }
    return value[31:24];
  }
}

function crypto_rol32_by_byte {
  returns Bits<32>
  arguments
    Bits<32> value,
    Bits<2> byte_select
  description {
    Rotate a 32-bit value left by a byte-selected multiple of eight bits.
  }
  body {
    if (byte_select == 0) {
      return value;
    } else if (byte_select == 1) {
      return (value << 8) | (value >> 24);
    } else if (byte_select == 2) {
      return (value << 16) | (value >> 16);
    }
    return (value << 24) | (value >> 8);
  }
}

function crypto_aes_xtime {
  returns Bits<8>
  arguments Bits<8> value
  description {
    Multiply an AES field element by x.
  }
  body {
    Bits<8> shifted = value << 1;
    return value[7] == 1 ? shifted ^ 0x1b : shifted;
  }
}

function crypto_aes_gf_mul {
  returns Bits<8>
  arguments
    Bits<8> multiplicand,
    Bits<8> multiplier
  description {
    Multiply two elements in the AES GF(2^8) field.
  }
  body {
    Bits<8> result = 0;
    Bits<8> a = multiplicand;
    Bits<8> b = multiplier;

    for (U32 i = 0; i < 8; i++) {
      if (b[0] == 1) {
        result = result ^ a;
      }
      a = crypto_aes_xtime(a);
      b = b >> 1;
    }

    return result;
  }
}

