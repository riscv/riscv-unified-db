{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/riscv/riscv-unified-db/tree/main/spec/schemas/v0.1/profile_release_schema.json",
  "type": "object",
  "required": ["$schema", "kind", "name", "long_name", "description"],
  "properties": {
    "$schema": {
      "enum": [
        "profile_release_schema.json#",
        "v0.1/profile_release_schema.json#"
      ]
    },
    "kind": {
      "const": "profile release"
    },
    "name": {
      "type": "string",
      "description": "Name (database key) of this Profile Release"
    },
    "long name": {
      "type": "string",
      "description": "One line description of this Profile Release"
    }
  }
}
